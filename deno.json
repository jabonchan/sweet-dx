{
    "name": "@jabonchan/sweet-dx",
    "version": "0.0.4",
    "license": "GPL-3.0-or-later",
    "exports": "./main.ts",
    "imports": {
        "@std/assert": "jsr:@std/assert@1.0.19"
    },
    "nodeModulesDir": "auto",
    "test": {
        "include": ["tests/"]
    },
    "fmt": {
        "exclude": ["./"]
    },
    "tasks": {
        "test": "deno test -A",
        "run": "deno run -A main.ts --source=./source --log-file=debug.log --output=./output",

        "compile-linux-x86_64":     "deno compile --include ./assets --target x86_64-unknown-linux-gnu --output ./build/sweetdx-x86_64-linux --allow-all main.ts",
        "compile-linux-aarch64":    "deno compile --include ./assets --target aarch64-unknown-linux-gnu --output ./build/sweetdx-arch64-linux --allow-all main.ts",
        "compile-windows-x86_64":   "deno compile --include ./assets --target x86_64-pc-windows-msvc --output ./build/sweetdx-x86_64-windows.exe --allow-all main.ts",
        "compile-windows-aarch64":  "deno compile --include ./assets --target aarch64-pc-windows-msvc --output ./build/sweetdx-arch64-windows.exe --allow-all main.ts",
        "compile-macos-x86_64":     "deno compile --include ./assets --target x86_64-apple-darwin --output ./build/sweetdx-x86_64-macos --allow-all main.ts",
        "compile-macos-aarch64":    "deno compile --include ./assets --target aarch64-apple-darwin --output ./build/sweetdx-arch64-macos --allow-all main.ts",

        "compile-linux":   "deno task compile-linux-x86_64 && deno task compile-linux-aarch64",
        "compile-windows": "deno task compile-windows-x86_64 && deno task compile-windows-aarch64",
        "compile-macos":   "deno task compile-macos-x86_64 && deno task compile-macos-aarch64",

        "compile": "deno task compile-linux && deno task compile-windows && deno task compile-macos"
    }
}
